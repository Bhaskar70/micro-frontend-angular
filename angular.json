{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": "5d534a77-ff60-4483-bb5a-e002815aef6b"
  },
  "newProjectRoot": "projects",
  "projects": {
    "weather": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/weather",
      "sourceRoot": "projects/weather/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-builders/custom-webpack:browser",
          "options": {
            "tsConfig": "projects/weather/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/weather/public",
                "output": "."
              }
            ],
            "styles": ["projects/weather/src/styles.scss"],
            "main": "projects/weather/src/main.ts",
            "outputPath": "dist/weather",
            "index": "projects\\weather\\src\\index.html",
            "customWebpackConfig": {
              "path": "projects/weather/webpack.config.js"
            },
            "commonChunk": false,
            "extractLicenses": false
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "customWebpackConfig": {
                "path": "projects/weather/webpack.prod.config.js"
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-builders/custom-webpack:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "weather:build:production"
            },
            "development": {
              "buildTarget": "weather:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "port": 4201,
            "publicHost": "http://localhost:4201",
            "headers": {
              "Access-Control-Allow-Origin": "*"
            }
          }
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    },
